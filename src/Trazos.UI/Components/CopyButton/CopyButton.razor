@namespace Trazos.UI.Components
@implements IAsyncDisposable

<span class="trazos-copy-button">
    <IconButton Label="@Label"
                Variant="Variant"
                Size="Size"
                Disabled="Disabled"
                Loading="Loading"
                Class="@Class"
                OnClick="HandleClickAsync"
                @attributes="AdditionalAttributes">
        @if (_status == CopyStatus.Copied)
        {
            @if (CheckIcon != null)
            {
                @CheckIcon
            }
            else
            {
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 13l4 4L19 7" />
                </svg>
            }
        }
        else if (Icon != null)
        {
            @Icon
        }
        else
        {
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="9" y="9" width="12" height="12" rx="2" />
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
            </svg>
        }
    </IconButton>
    @if (Message != null)
    {
        <span class="trazos-handwriting trazos-copy-button-note" aria-hidden="true">@Message</span>
    }
    <VisuallyHidden role="status" aria-live="polite">@Message</VisuallyHidden>
</span>
