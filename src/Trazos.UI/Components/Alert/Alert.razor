@namespace Trazos.UI.Components

@if (!_dismissed)
{
    <div class="trazos-alert trazos-alert-@ToneName @Class" role="@Role" @attributes="AdditionalAttributes">
        <span class="trazos-alert-icon" aria-hidden="true">
            @if (Icon != null)
            {
                @Icon
            }
            else
            {
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    @switch (Tone)
                    {
                        case AlertTone.Success:
                            <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            break;
                        case AlertTone.Warning:
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
                            break;
                        case AlertTone.Danger:
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
                            break;
                        default:
                            <path stroke-linecap="round" stroke-linejoin="round" d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z" />
                            break;
                    }
                </svg>
            }
        </span>

        <div class="trazos-alert-content">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="trazos-alert-title">@Title</p>
            }
            @if (ChildContent != null)
            {
                <div class="trazos-alert-body">@ChildContent</div>
            }
            @if (Actions != null)
            {
                <div class="trazos-alert-actions">@Actions</div>
            }
        </div>

        @if (Dismissible)
        {
            <button type="button" class="trazos-alert-dismiss" aria-label="@DismissLabel" @onclick="DismissAsync">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        }
    </div>
}
