@namespace Trazos.UI.Components
@typeparam TValue
@inherits FormFieldBase<TValue>

<div class="trazos-input-group @FieldStateClass @Class">
    @if (HasLabel)
    {
        <label id="@LabelId" class="trazos-input-label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="trazos-input-required" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="trazos-select-wrapper @(HasError ? "has-error" : "") @(Disabled ? "disabled" : "") @(_isOpen ? "is-open" : "")">
        @if (LeadingIcon != null)
        {
            <div class="trazos-input-icon leading">
                @LeadingIcon
            </div>
        }

        @if (UseListbox)
        {
            @* The list is drawn by the library so it follows the theme. Focus stays on
               the trigger; aria-activedescendant points screen readers at the active option. *@
            <button @ref="_trigger"
                    type="button"
                    id="@Id"
                    class="trazos-select-control trazos-select-trigger"
                    role="combobox"
                    aria-haspopup="listbox"
                    aria-expanded="@(_isOpen ? "true" : "false")"
                    aria-controls="@ListboxId"
                    aria-labelledby="@(HasLabel ? LabelId : null)"
                    aria-activedescendant="@(_isOpen && _activeIndex >= 0 ? GetOptionId(_activeIndex) : null)"
                    aria-invalid="@AriaInvalid"
                    aria-describedby="@DescribedBy"
                    aria-required="@(Required ? "true" : null)"
                    disabled="@Disabled"
                    @onclick="OnTriggerClick"
                    @onkeydown="OnKeyDownAsync"
                    @onkeydown:preventDefault="_isOpen"
                    @onblur="Close"
                    @attributes="AdditionalAttributes">
                <span class="trazos-select-value @(SelectedIndex < 0 ? "is-placeholder" : "")">@DisplayText</span>
            </button>

            @if (_isOpen)
            {
                <ul id="@ListboxId"
                    class="trazos-select-listbox"
                    role="listbox"
                    aria-labelledby="@(HasLabel ? LabelId : null)">
                    @for (var i = 0; i < _items.Count; i++)
                    {
                        var index = i;
                        var option = _items[i];
                        var isSelected = index == SelectedIndex;
                        <li id="@GetOptionId(index)"
                            role="option"
                            aria-selected="@(index == _activeIndex ? "true" : "false")"
                            aria-disabled="@(option.Disabled ? "true" : null)"
                            class="trazos-select-option @(index == _activeIndex ? "is-active" : "") @(isSelected ? "is-selected" : "") @(option.Disabled ? "is-disabled" : "")"
                            @onmousedown="() => ChooseAsync(index)"
                            @onmousedown:preventDefault="true"
                            @onmouseenter="() => { if (!option.Disabled) _activeIndex = index; }">
                            <span class="trazos-select-option-text">@option.Text</span>
                            @if (isSelected)
                            {
                                <svg class="trazos-select-check" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                                </svg>
                            }
                        </li>
                    }
                </ul>
            }
        }
        else
        {
            <select id="@Id"
                    class="trazos-select-control"
                    disabled="@Disabled"
                    value="@CurrentValueAsString"
                    aria-invalid="@AriaInvalid"
                    aria-describedby="@DescribedBy"
                    aria-required="@(Required ? "true" : null)"
                    @onchange="OnSelectionChanged"
                    @attributes="AdditionalAttributes">
                @if (!string.IsNullOrEmpty(Placeholder))
                {
                    <option value="" disabled selected="@HasNoValue">@Placeholder</option>
                }
                @if (Options is not null)
                {
                    foreach (var option in Options)
                    {
                        <option value="@FormatValueAsString(option.Value)" disabled="@option.Disabled">@option.Text</option>
                    }
                }
                @ChildContent
            </select>
        }

        <div class="trazos-select-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </div>
    </div>

    @if (HasHelperText)
    {
        <p id="@HelperId" class="trazos-input-helper">@HelperText</p>
    }

    @if (HasError)
    {
        <p id="@ErrorId" class="trazos-input-error" role="alert">@ErrorMessage</p>
    }
</div>
