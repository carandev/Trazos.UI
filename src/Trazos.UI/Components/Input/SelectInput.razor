@namespace Trazos.UI.Components
@typeparam TValue
@inherits FormFieldBase<TValue>

<div class="trazos-input-group @FieldStateClass @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="trazos-input-label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="trazos-input-required" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="trazos-select-wrapper @(HasError ? "has-error" : "") @(Disabled ? "disabled" : "")">
        @if (LeadingIcon != null)
        {
            <div class="trazos-input-icon leading">
                @LeadingIcon
            </div>
        }

        <select id="@Id"
                class="trazos-select-control"
                disabled="@Disabled"
                value="@CurrentValueAsString"
                aria-invalid="@AriaInvalid"
                aria-describedby="@DescribedBy"
                aria-required="@(Required ? "true" : null)"
                @onchange="OnSelectionChanged"
                @attributes="AdditionalAttributes">
            @if (!string.IsNullOrEmpty(Placeholder))
            {
                <option value="" disabled selected="@HasNoValue">@Placeholder</option>
            }
            @if (Options is not null)
            {
                foreach (var option in Options)
                {
                    <option value="@FormatValueAsString(option.Value)" disabled="@option.Disabled">@option.Text</option>
                }
            }
            @ChildContent
        </select>

        <div class="trazos-select-arrow" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
            </svg>
        </div>
    </div>

    @if (HasHelperText)
    {
        <p id="@HelperId" class="trazos-input-helper">@HelperText</p>
    }

    @if (HasError)
    {
        <p id="@ErrorId" class="trazos-input-error" role="alert">@ErrorMessage</p>
    }
</div>
