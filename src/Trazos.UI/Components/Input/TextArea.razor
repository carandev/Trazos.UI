@namespace Trazos.UI.Components
@inherits FormFieldBase<string?>

<div class="trazos-input-group @FieldStateClass @Class">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="trazos-input-label" for="@Id">
            @Label
            @if (Required)
            {
                <span class="trazos-input-required" aria-hidden="true">*</span>
            }
        </label>
    }

    <div class="trazos-textarea-wrapper @(HasError ? "has-error" : "") @(Disabled ? "disabled" : "")">
        <textarea id="@Id"
                  rows="@Rows"
                  class="trazos-textarea-control"
                  placeholder="@Placeholder"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  value="@CurrentValueAsString"
                  aria-invalid="@AriaInvalid"
                  aria-describedby="@DescribedBy"
                  aria-required="@(Required ? "true" : null)"
                  @oninput="OnInputChanged"
                  @attributes="AdditionalAttributes"></textarea>
    </div>

    @if (HasHelperText)
    {
        <p id="@HelperId" class="trazos-input-helper">@HelperText</p>
    }

    @if (HasError)
    {
        <p id="@ErrorId" class="trazos-input-error" role="alert">@ErrorMessage</p>
    }
</div>
