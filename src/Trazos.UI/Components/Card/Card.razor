@namespace Trazos.UI.Components

<div class="trazos-card-box trazos-card-@VariantClass @(Fill ? "trazos-card-fill" : null) @Class"
     @onclick="OnClick"
     @attributes="AdditionalAttributes">
    @if (Media != null)
    {
        <div class="trazos-card-media">
            @Media
        </div>
    }

    @if (Header != null)
    {
        <div class="trazos-card-header">
            @Header
        </div>
    }

    <div class="trazos-card-body">
        @ChildContent
    </div>

    @if (Footer != null)
    {
        <div class="trazos-card-footer">
            @Footer
        </div>
    }
</div>
