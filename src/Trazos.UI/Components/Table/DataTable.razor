@namespace Trazos.UI.Components
@typeparam TItem

<CascadingValue TValue="IDataTableSortContext" Value="this" IsFixed="true">
<div class="trazos-table-wrapper @Class">
    @if (Toolbar != null)
    {
        <div class="trazos-table-toolbar">@Toolbar</div>
    }
    <div class="trazos-table-container">
        <table class="trazos-table" aria-label="@AriaLabel">
            @if (TableHeader != null)
            {
                <thead class="trazos-table-head">
                    <tr>
                        @TableHeader
                        @if (RowActions != null)
                        {
                            <th class="trazos-table-actions-head" scope="col">
                                <VisuallyHidden>@ActionsLabel</VisuallyHidden>
                            </th>
                        }
                    </tr>
                </thead>
            }

            <tbody class="trazos-table-body">
                @if (Loading)
                {
                    @for (int i = 0; i < LoadingRows; i++)
                    {
                        <tr class="trazos-table-loading-row">
                            <td colspan="100">
                                <Skeleton Variant="SkeletonVariant.Text" Height="1.25rem" />
                            </td>
                        </tr>
                    }
                }
                else if (Items == null || !Items.Any())
                {
                    <tr>
                        <td colspan="100" class="trazos-table-empty">
                            @if (EmptyContent != null)
                            {
                                @EmptyContent
                            }
                            else
                            {
                                <p class="trazos-table-empty-text">@EmptyMessage</p>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Items)
                    {
                        <tr class="trazos-table-row @(IsInteractive ? "interactive" : "")"
                            tabindex="@(IsInteractive ? "0" : null)"
                            aria-label="@(IsInteractive ? RowAriaLabel?.Invoke(item) : null)"
                            @onclick="() => HandleRowClick(item)"
                            @onkeydown="e => HandleRowKeyDown(e, item)">
                            @RowTemplate(item)
                            @if (RowActions != null)
                            {
                                <td class="trazos-table-actions" @onclick:stopPropagation="true" @onkeydown:stopPropagation="true">
                                    <div class="trazos-table-actions-inner">@RowActions(item)</div>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>

            @if (TableFooter != null)
            {
                <tfoot class="trazos-table-foot">
                    <tr>
                        @TableFooter
                        @if (RowActions != null)
                        {
                            <td></td>
                        }
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    @if (Pagination != null)
    {
        <div class="trazos-table-pagination">@Pagination</div>
    }
</div>
</CascadingValue>
