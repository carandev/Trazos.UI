@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation

@* Keyed by language and framework: switching either rebuilds the shell and the current page. *@
<AppShell @key="(L.Current, F.Current)" @ref="_shell" ContainerClass="docs-container">
    <Brand>
        <a href="" class="docs-brand">
            <span class="docs-brand-mark" aria-hidden="true">T</span>
            <span class="docs-brand-name trazos-heading">Trazos.UI</span>
        </a>
    </Brand>

    <TopBar>
        <div class="docs-topbar">
            <nav class="docs-topbar-links" aria-label="@L.T("Project links", "Enlaces del proyecto")">
                @if (F.IsReact)
                {
                    <a href="@DocsLinks.Npm" target="_blank" rel="noopener noreferrer">npm</a>
                }
                else
                {
                    <a href="@DocsLinks.NuGet" target="_blank" rel="noopener noreferrer">NuGet</a>
                }
                <a href="@DocsLinks.GitHub" target="_blank" rel="noopener noreferrer">GitHub</a>
            </nav>
            <FrameworkSwitch />
            <ThemeSwitch />
            <LanguageSwitch />
        </div>
    </TopBar>

    <Sidebar>
        <DocsSidebar />
    </Sidebar>

    <Body>
        @Body
    </Body>
</AppShell>

@code {
    private AppShell? _shell;

    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        L.Changed += OnLanguageChanged;
        F.Changed += OnLanguageChanged;
    }

    // The mobile drawer reuses the sidebar, so it must close after a navigation link is followed.
    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _shell?.CloseDrawer();

    private void OnLanguageChanged() => StateHasChanged();

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        L.Changed -= OnLanguageChanged;
        F.Changed -= OnLanguageChanged;
    }
}
