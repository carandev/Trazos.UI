<section class="docs-demo">
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3 class="docs-demo-title">@Title</h3>
    }
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="docs-demo-description">@Description</p>
    }

    @* The search index needs only the title and description: no live demo, no code. *@
    @if (!Indexing)
    {
        <div class="docs-demo-preview">
            @if (!F.IsReact)
            {
                @ChildContent
            }
            else if (React is not null)
            {
                <ReactDemo @key="React" Id="@React" />
            }
            else
            {
                <p class="docs-muted">@L.T("This example is only available for Blazor.", "Este ejemplo solo está disponible para Blazor.")</p>
            }
        </div>

        @if (F.IsReact && React is not null)
        {
            <details class="docs-demo-source" open="@ShowCode">
                <summary>@L.T("Show code", "Ver código")</summary>
                <ReactSource @key="React" Id="@React" />
            </details>
        }
        else if (!F.IsReact && !string.IsNullOrEmpty(Code))
        {
            <details class="docs-demo-source" open="@ShowCode">
                <summary>@L.T("Show code", "Ver código")</summary>
                <CodeBlock Code="@Code" />
            </details>
        }
    }
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }

    /// <summary>Razor snippet shown in Blazor mode.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>
    /// The React version of this demo: the id of apps/docs-react/src/demos/&lt;id&gt;.tsx,
    /// such as "badge/variants". In React mode it renders live and its source is the code shown.
    /// </summary>
    [Parameter] public string? React { get; set; }

    [Parameter] public bool ShowCode { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    [CascadingParameter(Name = SearchIndexHost.CascadeName)] public bool Indexing { get; set; }
}
