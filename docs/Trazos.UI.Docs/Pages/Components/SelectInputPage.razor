@page "/components/select-input"

<DocPage Title="SelectInput" Category="@L.T("Forms", "Formularios")"
         Lead="@F.Pick(L.T("A select bound to any type: strings, enums, ids such as int or Guid, and their nullable forms. With typed Options it draws its own list, so the popup follows the theme in light and dark mode; with <option> children it stays a native select.", "Un select enlazado a cualquier tipo: textos, enums, ids como int o Guid, y sus versiones anulables. Con Options tipadas dibuja su propia lista, así que el desplegable sigue el tema claro y oscuro; con hijos <option> sigue siendo un select nativo."), L.T("A select for string or number values. With typed options it draws its own list, so the popup follows the theme in light and dark mode; with <option> children it stays a native select.", "Un select para valores de texto o numéricos. Con options tipadas dibuja su propia lista, así que el desplegable sigue el tema claro y oscuro; con hijos <option> sigue siendo un select nativo."))">

    <DemoBlock Code="@Code" React="select-input/basic"
               Description="@L.T("Typed options render the library list: a themed popup with the selected option checked and disabled options dimmed.", "Las opciones tipadas muestran la lista de la librería: un desplegable con el tema, la opción elegida marcada y las opciones deshabilitadas atenuadas.")">
        <div class="docs-stack">
            <SelectInput Label="@L.T("Team", "Equipo")" Placeholder="@L.T("Choose a team", "Elige un equipo")" Required="true"
                         HelperText="@L.T("Open it with a click, or focus it and press the down arrow.", "Ábrelo con un clic, o enfócalo y presiona la flecha hacia abajo.")"
                         Options="Teams" @bind-Value="_team" />
            <p class="docs-demo-output">@L.T("Value:", "Valor:") <strong>@(_team ?? "null")</strong></p>
        </div>
    </DemoBlock>

    <DemoBlock Title="@L.T("Typed values", "Valores tipados")"
               Description="@F.Pick(L.T("Options builds the list from typed values. SelectOption.ForEnum and ForNullableEnum create one option per enum member; pass a function to translate the text.", "Options arma la lista con valores tipados. SelectOption.ForEnum y ForNullableEnum crean una opción por cada miembro del enum; pasa una función para traducir el texto."), L.T("options builds the list from { value, label, disabled } objects. A number value comes back as a number, and a string union keeps its type.", "options arma la lista con objetos { value, label, disabled }. Un valor numérico vuelve como número, y una unión de textos conserva su tipo."))"
               Code="@TypedCode" React="select-input/typed">
        <div class="docs-grid-2">
            <SelectInput Label="@L.T("Pay frequency", "Frecuencia de pago")" Placeholder="@L.T("Choose", "Elige")"
                         Options="SelectOption.ForNullableEnum<PayFrequency>(FrequencyText)" @bind-Value="_frequency" />
            <SelectInput Label="@L.T("Company", "Empresa")" Placeholder="@L.T("Choose", "Elige")" Options="_companies" @bind-Value="_companyId" />
        </div>
        <p class="docs-demo-output">@L.T("Frequency:", "Frecuencia:") <strong>@(_frequency?.ToString() ?? "null")</strong> · @L.T("Company id:", "Id de empresa:") <strong>@_companyId</strong></p>
    </DemoBlock>

    <DemoBlock Title="@L.T("Error and disabled", "Error y deshabilitado")" Code="@StatesCode" React="select-input/states">
        <div class="docs-grid-2">
            <SelectInput Label="@L.T("Shift", "Turno")" Placeholder="@L.T("Pick a shift", "Elige un turno")" Options="Shifts" @bind-Value="_shift"
                         Error="@L.T("Choose a shift to continue.", "Elige un turno para continuar.")" />
            <SelectInput Label="@L.T("Disabled", "Deshabilitado")" Placeholder="@L.T("Unavailable", "No disponible")" Options="Shifts" @bind-Value="_disabledShift" Disabled="true" />
        </div>
    </DemoBlock>

    <DemoBlock Title="@L.T("Native select with <option> children", "Select nativo con hijos <option>")"
               Description="@F.Pick(L.T("With <option> children (alone or mixed with Options) the field stays a native select, because Blazor cannot read ChildContent. Phones open their own picker, and the popup still takes the theme colors.", "Con hijos <option> (solos o mezclados con Options) el campo sigue siendo un select nativo, porque Blazor no puede leer ChildContent. Los teléfonos abren su propio selector y el desplegable igual toma los colores del tema."), L.T("With <option> children (alone or mixed with options) the field stays a native select. Phones open their own picker, and the popup still takes the theme colors.", "Con hijos <option> (solos o mezclados con options) el campo sigue siendo un select nativo. Los teléfonos abren su propio selector y el desplegable igual toma los colores del tema."))"
               Code="@NativeCode" React="select-input/native">
        <div class="docs-stack">
            <SelectInput Label="@L.T("Country", "País")" Placeholder="@L.T("Choose a country", "Elige un país")" @bind-Value="_country">
                <option value="co">Colombia</option>
                <option value="mx">@L.T("Mexico", "México")</option>
                <option value="pe">@L.T("Peru", "Perú")</option>
            </SelectInput>
            <p class="docs-demo-output">@L.T("Value:", "Valor:") <strong>@(_country ?? "null")</strong></p>
        </div>
    </DemoBlock>

    <h2 class="docs-h2">@L.T("How to use", "Cómo usarlo")</h2>

    <h3 class="docs-h3">@L.T("When to use it", "Cuándo usarlo")</h3>
    <p>
        @L.T("Use SelectInput to pick one value from a known list of about 5 to 30 options: a team, a company, a pay frequency, a department. With two to five options that people should compare at a glance, a radio group shows them all at once. With hundreds of options, or when people know what they are looking for, use Autocomplete so they can type.",
             "Usa SelectInput para elegir un valor de una lista conocida de unas 5 a 30 opciones: un equipo, una empresa, una frecuencia de pago, un área. Con dos a cinco opciones que conviene comparar de un vistazo, un grupo de radio las muestra todas a la vez. Con cientos de opciones, o cuando las personas saben lo que buscan, usa Autocomplete para que puedan escribir.")
    </p>

    <h3 class="docs-h3">@L.T("Library list or native select", "Lista de la librería o select nativo")</h3>
    <p>
        @L.T("SelectInput picks how to draw the list from what you pass:", "SelectInput decide cómo dibujar la lista según lo que le pases:")
    </p>
    <ul>
        <li>@F.Pick(L.T("Options only: the library list. The trigger and the popup use the theme tokens, so they look right in light and dark mode, mark the selected option with a check, and match the field's error and disabled looks. This is the recommended form.", "Solo Options: la lista de la librería. El disparador y el desplegable usan los tokens del tema, así que se ven bien en modo claro y oscuro, marcan la opción elegida con un check y respetan el aspecto de error y deshabilitado del campo. Es la forma recomendada."), L.T("options only: the library list. The trigger and the popup use the theme tokens, so they look right in light and dark mode, mark the selected option with a check, and match the field's error and disabled looks. This is the recommended form.", "Solo options: la lista de la librería. El disparador y el desplegable usan los tokens del tema, así que se ven bien en modo claro y oscuro, marcan la opción elegida con un check y respetan el aspecto de error y deshabilitado del campo. Es la forma recomendada."))</li>
        <li>@F.Pick(L.T("<option> children, alone or mixed with Options: a native select. Blazor cannot inspect ChildContent, so the browser draws the popup; its options still get the theme surface and text colors. Use it when you want the phone's own picker.", "Hijos <option>, solos o mezclados con Options: un select nativo. Blazor no puede inspeccionar ChildContent, así que el navegador dibuja el desplegable; aun así sus opciones toman la superficie y el color de texto del tema. Úsalo cuando quieras el selector propio del teléfono."), L.T("<option> children, alone or mixed with options: a native select. The browser draws the popup; its options still get the theme surface and text colors. Use it when you want the phone's own picker.", "Hijos <option>, solos o mezclados con options: un select nativo. El navegador dibuja el desplegable; aun así sus opciones toman la superficie y el color de texto del tema. Úsalo cuando quieras el selector propio del teléfono."))</li>
    </ul>

    <h3 class="docs-h3">@L.T("Step by step", "Paso a paso")</h3>
    <ol>
        <li>@F.Pick(L.T("Choose the bound type: string, an enum, an id such as int or Guid, or a nullable form. Use a nullable type (PayFrequency?, int?) when the field can start empty.", "Elige el tipo enlazado: string, un enum, un id como int o Guid, o una versión anulable. Usa un tipo anulable (PayFrequency?, int?) cuando el campo pueda empezar vacío."), L.T("Choose the value type: a string, a string union such as 'weekly' | 'monthly', or a number id. Keep it in state as T | null, where null means nothing is selected yet.", "Elige el tipo del valor: un texto, una unión de textos como 'weekly' | 'monthly', o un id numérico. Guárdalo en el estado como T | null, donde null significa que aún no hay selección."))</li>
        <li>@F.Pick(L.T("Build the options: Options with SelectOption<T>(Value, Text, Disabled), SelectOption.ForEnum for enums, or plain <option> children. Prefer Options: they render the library list. Children switch to the native select.", "Arma las opciones: Options con SelectOption<T>(Value, Text, Disabled), SelectOption.ForEnum para enums, o hijos <option> simples. Prefiere Options: muestran la lista de la librería. Los hijos cambian al select nativo."), L.T("Build the options: pass options as { value, label, disabled } objects, or plain <option> children. Prefer options: they render the library list. Children switch to the native select. Write SelectInput<number> when TypeScript cannot infer the type.", "Arma las opciones: pasa options como objetos { value, label, disabled }, o hijos <option> simples. Prefiere options: muestran la lista de la librería. Los hijos cambian al select nativo. Escribe SelectInput<number> cuando TypeScript no pueda inferir el tipo."))</li>
        <li>@F.Pick(L.T("Add a Placeholder such as \"Choose\". It shows while the value is empty and is never a choosable option, so the form never preselects an answer for the user.", "Agrega un Placeholder como \"Elige\". Se muestra mientras el valor está vacío y nunca es una opción elegible, así el formulario nunca elige una respuesta por el usuario."), L.T("Add a placeholder such as \"Choose\". It shows while the value is null or '' and is never a choosable option, so the form never preselects an answer for the user.", "Agrega un placeholder como \"Elige\". Se muestra mientras el valor es null o '' y nunca es una opción elegible, así el formulario nunca elige una respuesta por el usuario."))</li>
        <li>@F.Pick(L.T("Bind with @bind-Value and validate inside an EditForm, or pass Error by hand.", "Enlaza con @bind-Value y valida dentro de un EditForm, o pasa Error a mano."), L.T("Pass value and onValueChange, or defaultValue for uncontrolled use, and pass error when the selection is missing or invalid.", "Pasa value y onValueChange, o defaultValue para uso no controlado, y pasa error cuando falte la selección o no sea válida."))</li>
    </ol>

    <h3 class="docs-h3">@L.T("Binding and validation", "Enlace y validación")</h3>
    <p>
        @F.Pick(L.T("Inside an EditForm, [Required] on a nullable property such as PayFrequency? works out of the box: the placeholder keeps the value null until the user chooses. With a non-nullable enum or int, the default value (the first member, or 0) already counts as an answer, so prefer nullable types for required choices.", "Dentro de un EditForm, [Required] sobre una propiedad anulable como PayFrequency? funciona sin más: el placeholder deja el valor en null hasta que el usuario elige. Con un enum o int no anulable, el valor por defecto (el primer miembro, o 0) ya cuenta como respuesta, así que usa tipos anulables para las elecciones obligatorias."),
                L.T("A typed option reports its own value, so a number stays a number. <option> children always report their string value. To require a choice, check for null and pass the message as error.", "Una opción tipada informa su propio valor, así que un número sigue siendo número. Los hijos <option> siempre informan su valor como texto. Para exigir una elección, revisa si es null y pasa el mensaje en error."))
    </p>
    <CodeBlock Language="@F.Pick("razor", "tsx")" Code="@F.Pick(BindCode, ReactBindCode)" />

    <h3 class="docs-h3">@L.T("Keyboard and mouse (library list)", "Teclado y mouse (lista de la librería)")</h3>
    <ul>
        <li>@L.T("Down or Up arrow opens the list on the selected option (or the first or last enabled one) and then moves through the options, skipping disabled ones. Home and End jump to the first and last enabled option.", "La flecha abajo o arriba abre la lista en la opción elegida (o en la primera o última habilitada) y luego recorre las opciones, saltando las deshabilitadas. Inicio y Fin saltan a la primera y a la última opción habilitada.")</li>
        <li>@L.T("Enter or Space opens the list, and once it is open chooses the active option and closes it. Escape closes without changing the value.", "Enter o Espacio abren la lista y, ya abierta, eligen la opción activa y la cierran. Escape la cierra sin cambiar el valor.")</li>
        <li>@L.T("Typing letters jumps to the first enabled option whose text starts with them; typing the same letter again cycles through the matches.", "Escribir letras salta a la primera opción habilitada cuyo texto empieza con ellas; repetir la misma letra recorre las coincidencias.")</li>
        <li>@F.Pick(L.T("Tab closes the list. While the list is open, the field keeps the keys so the page does not scroll, so the first Tab closes it and the next one moves on.", "Tab cierra la lista. Mientras la lista está abierta, el campo retiene las teclas para que la página no se desplace, así que el primer Tab la cierra y el siguiente avanza."), L.T("Tab closes the list and moves focus to the next field.", "Tab cierra la lista y mueve el foco al siguiente campo."))</li>
        <li>@L.T("A click opens or closes the list, a click on an option chooses it, and a click anywhere else closes it. Focus stays on the field the whole time.", "Un clic abre o cierra la lista, un clic en una opción la elige y un clic en cualquier otro lugar la cierra. El foco se queda en el campo todo el tiempo.")</li>
    </ul>

    <h3 class="docs-h3">@L.T("Screen readers", "Lectores de pantalla")</h3>
    <ul>
        <li>@L.T("The library list follows the select-only combobox pattern: the field is a button with role=\"combobox\", aria-haspopup=\"listbox\", aria-expanded and aria-controls, named by its label through aria-labelledby. The popup is a role=\"listbox\" of role=\"option\" items.", "La lista de la librería sigue el patrón de combobox de solo selección: el campo es un botón con role=\"combobox\", aria-haspopup=\"listbox\", aria-expanded y aria-controls, nombrado por su etiqueta con aria-labelledby. El desplegable es un role=\"listbox\" con elementos role=\"option\".")</li>
        <li>@L.T("Focus never leaves the field: aria-activedescendant points at the active option, which carries aria-selected=\"true\", so screen readers announce each option as you move. The chosen value is the field's text.", "El foco nunca sale del campo: aria-activedescendant apunta a la opción activa, que lleva aria-selected=\"true\", así que los lectores de pantalla anuncian cada opción al moverse. El valor elegido es el texto del campo.")</li>
        <li>@L.T("Disabled options carry aria-disabled=\"true\": they are announced as unavailable and cannot be chosen.", "Las opciones deshabilitadas llevan aria-disabled=\"true\": se anuncian como no disponibles y no se pueden elegir.")</li>
        <li>@L.T("Helper text and error are linked with aria-describedby; an error also sets aria-invalid, and Required sets aria-required. The native select gets the same attributes and keeps the browser's own keyboard behavior.", "El texto de ayuda y el error se vinculan con aria-describedby; un error también agrega aria-invalid, y Required agrega aria-required. El select nativo recibe los mismos atributos y conserva el comportamiento de teclado propio del navegador.")</li>
    </ul>

    <h3 class="docs-h3">@L.T("Common pitfalls", "Errores comunes")</h3>
    <ul>
        <li>@F.Pick(L.T("Omitting TValue when there is no Value or Options to infer it from: set TValue=\"string\".", "Omitir TValue cuando no hay Value ni Options para inferirlo: usa TValue=\"string\"."), L.T("Mixing number options with <option> children: the children report strings, so the handler gets both types.", "Mezclar opciones numéricas con hijos <option>: los hijos informan textos, así que el manejador recibe ambos tipos."))</li>
        <li>@L.T("Two options with the same value: the select cannot tell them apart.", "Dos opciones con el mismo valor: el select no puede distinguirlas.")</li>
        <li>@F.Pick(L.T("Adding one <option> child next to Options \"to add an extra choice\": it turns the whole field back into a native select. Add the choice to Options instead.", "Agregar un hijo <option> junto a Options \"para sumar una opción\": todo el campo vuelve a ser un select nativo. Agrega la opción a Options."), L.T("Adding one <option> child next to options \"to add an extra choice\": it turns the whole field back into a native select. Add the choice to options instead.", "Agregar un hijo <option> junto a options \"para sumar una opción\": todo el campo vuelve a ser un select nativo. Agrega la opción a options."))</li>
        <li>@L.T("Showing enum member names to users: pass translated text instead.", "Mostrar a los usuarios los nombres de los miembros del enum: pasa textos traducidos.")</li>
    </ul>

    <ApiTable Params="Params" ReactParams="ReactParams" />
</DocPage>

@code {
    private string? _team;
    private string? _shift;
    private string? _disabledShift;
    private string? _country;
    private PayFrequency? _frequency;
    private int _companyId;

    private enum PayFrequency { Weekly, Biweekly, Monthly }

    private readonly IReadOnlyList<SelectOption<int>> _companies =
    [
        new(1, "Acme S.A.S."),
        new(2, "Globex Ltda."),
        new(3, "Initech (inactive)", Disabled: true),
    ];

    private IReadOnlyList<SelectOption<string?>> Teams =>
    [
        new("design", L.T("Design", "Diseño")),
        new("engineering", L.T("Engineering", "Ingeniería")),
        new("marketing", L.T("Marketing", "Marketing")),
        new("legal", L.T("Legal (no openings)", "Legal (sin vacantes)"), Disabled: true),
    ];

    private IReadOnlyList<SelectOption<string?>> Shifts =>
    [
        new("am", L.T("Morning", "Mañana")),
        new("pm", L.T("Afternoon", "Tarde")),
    ];

    private string FrequencyText(PayFrequency value) => value switch
    {
        PayFrequency.Weekly => L.T("Weekly", "Semanal"),
        PayFrequency.Biweekly => L.T("Biweekly", "Quincenal"),
        _ => L.T("Monthly", "Mensual"),
    };

    private const string BindCode = """
        <EditForm Model="_employee" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <SelectInput Label="Pay frequency" Placeholder="Choose"
                         Options="SelectOption.ForNullableEnum<PayFrequency>()"
                         @bind-Value="_employee.Frequency" />
        </EditForm>

        @code {
            private sealed class Employee
            {
                [Required(ErrorMessage = "Choose a pay frequency.")]
                public PayFrequency? Frequency { get; set; }
            }
        }
        """;

    private const string ReactBindCode = """
        const companies: SelectOption<number>[] = [
          { value: 1, label: 'Acme S.A.S.' },
          { value: 2, label: 'Globex Ltda.' },
        ];

        const [companyId, setCompanyId] = useState<number | null>(null);

        <SelectInput<number> label="Company" placeholder="Choose" required
                             options={companies}
                             value={companyId} onValueChange={setCompanyId}
                             error={submitted && companyId === null ? 'Choose a company.' : undefined} />
        """;

    private const string TypedCode = """
        <SelectInput Label="Pay frequency" Placeholder="Choose"
                     Options="SelectOption.ForNullableEnum<PayFrequency>()"
                     @bind-Value="_frequency" />

        <SelectInput Label="Company" Placeholder="Choose"
                     Options="_companies"
                     @bind-Value="_companyId" />

        @code {
            private PayFrequency? _frequency;
            private int _companyId;

            private readonly IReadOnlyList<SelectOption<int>> _companies =
            [
                new(1, "Acme S.A.S."),
                new(2, "Globex Ltda."),
                new(3, "Initech (inactive)", Disabled: true),
            ];
        }
        """;

    private const string Code = """
        <SelectInput Label="Team" Placeholder="Choose a team" Required="true"
                     HelperText="Open it with a click, or focus it and press the down arrow."
                     Options="_teams" @bind-Value="_team" />

        @code {
            private string? _team;

            private readonly IReadOnlyList<SelectOption<string?>> _teams =
            [
                new("design", "Design"),
                new("engineering", "Engineering"),
                new("marketing", "Marketing"),
                new("legal", "Legal (no openings)", Disabled: true),
            ];
        }
        """;

    private const string StatesCode = """
        <SelectInput Label="Shift" Placeholder="Pick a shift" Options="_shifts" @bind-Value="_shift"
                     Error="Choose a shift to continue." />
        <SelectInput Label="Disabled" Placeholder="Unavailable" Options="_shifts" @bind-Value="_other"
                     Disabled="true" />

        @code {
            private string? _shift;
            private string? _other;

            private readonly IReadOnlyList<SelectOption<string?>> _shifts =
            [
                new("am", "Morning"),
                new("pm", "Afternoon"),
            ];
        }
        """;

    private const string NativeCode = """
        <SelectInput Label="Country" Placeholder="Choose a country" @bind-Value="_country">
            <option value="co">Colombia</option>
            <option value="mx">Mexico</option>
            <option value="pe">Peru</option>
        </SelectInput>

        @code {
            private string? _country;
        }
        """;

    private IReadOnlyList<ApiParam> Params =>
    [
        new("TValue", "type", L.T("inferred", "inferido"), L.T("Bound type. Inferred from Value or Options; set TValue=\"string\" when neither is given.", "Tipo enlazado. Se infiere de Value u Options; usa TValue=\"string\" cuando no pasas ninguno.")),
        new("Value", "TValue", null, L.T("Selected value. Supports @bind-Value.", "Valor seleccionado. Admite @bind-Value.")),
        new("ValueChanged", "EventCallback<TValue>", null, L.T("Raised when the selection changes.", "Se dispara cuando cambia la selección.")),
        new("ValueExpression", "Expression<Func<TValue>>?", null, L.T("Set by @bind-Value. Links the field to the EditContext of an EditForm (see Forms and validation).", "Lo asigna @bind-Value. Vincula el campo al EditContext de un EditForm (ver Formularios y validación).")),
        new("Options", "IEnumerable<SelectOption<TValue>>?", null, L.T("Typed options (Value, Text, Disabled). Alone, they render the library list that follows the theme; with ChildContent they render first inside a native select.", "Opciones tipadas (Value, Text, Disabled). Solas, muestran la lista de la librería que sigue el tema; con ChildContent se muestran primero dentro de un select nativo.")),
        new("ChildContent", "RenderFragment?", null, L.T("<option> elements. Their value is converted to TValue. Any children keep the native select.", "Elementos <option>. Su valor se convierte a TValue. Si hay hijos, el campo usa el select nativo.")),
        new("ParseErrorMessage", "string", "\"Enter a valid value.\"", L.T("Shown when an <option> value cannot be converted to TValue (native select only).", "Se muestra cuando el valor de un <option> no se puede convertir a TValue (solo select nativo).")),
        new("Placeholder", "string?", null, L.T("Text shown while nothing is selected. It is never a choosable option (in the native select it is a disabled first option).", "Texto que se muestra mientras no hay nada seleccionado. Nunca es una opción elegible (en el select nativo es una primera opción deshabilitada).")),
        new("Label", "string?", null, L.T("Visible label.", "Etiqueta visible.")),
        new("HelperText", "string?", null, L.T("Hint below the field.", "Ayuda debajo del campo.")),
        new("Error", "string?", null, L.T("Error message. Inside an EditForm it defaults to the validation message.", "Mensaje de error. Dentro de un EditForm toma el mensaje de validación.")),
        new("Required", "bool", "false", L.T("Shows an asterisk next to the label. It does not add the native required attribute.", "Muestra un asterisco junto a la etiqueta. No agrega el atributo nativo required.")),
        new("Disabled", "bool", "false", L.T("Disables the field.", "Deshabilita el campo.")),
        new("LeadingIcon", "RenderFragment?", null, L.T("Icon inside the field, on the left.", "Ícono dentro del campo, a la izquierda.")),
        new("Id", "string", "generated", L.T("Id of the control: the combobox button of the library list, or the <select>. The list uses {Id}-listbox and {Id}-option-{index}.", "Id del control: el botón combobox de la lista de la librería, o el <select>. La lista usa {Id}-listbox y {Id}-option-{index}.")),
        new("Class", "string?", null, L.T("Extra CSS classes.", "Clases CSS adicionales.")),
        new("AdditionalAttributes", "Dictionary<string, object>?", null, L.T("Extra attributes for the control: the combobox button or the <select>.", "Atributos adicionales para el control: el botón combobox o el <select>.")),
    ];

    private IReadOnlyList<ApiParam> ReactParams =>
    [
        new("T", "string | number", "string", L.T("Value type. Inferred from value or options; write SelectInput<number> when it cannot be inferred.", "Tipo del valor. Se infiere de value u options; escribe SelectInput<number> cuando no se pueda inferir.")),
        new("value", "T | null", null, L.T("Controlled selected value; '' or null shows the placeholder. Pair it with onValueChange.", "Valor seleccionado controlado; '' o null muestra el marcador de posición. Úsalo junto con onValueChange.")),
        new("defaultValue", "T | null", null, L.T("Initial value for uncontrolled use.", "Valor inicial para uso no controlado.")),
