@page "/components/card"

<DocPage Title="Card" Category="@L.T("Display", "Visualización")"
         Lead="@L.T("A sketch-bordered surface that groups related content, with optional header and footer slots.", "Una superficie con borde de boceto que agrupa contenido relacionado, con espacios opcionales de encabezado y pie.")">

    <DemoBlock Title="@L.T("Variants", "Variantes")" Code="@VariantsCode">
        <div class="docs-grid-2">
            @foreach (var variant in Enum.GetValues<CardVariant>())
            {
                <Card Variant="variant">
                    <h3 class="trazos-heading">@variant</h3>
                    <p class="docs-muted">CardVariant.@variant</p>
                </Card>
            }
        </div>
    </DemoBlock>

    <DemoBlock Title="@L.T("Header and footer", "Encabezado y pie")" Code="@SlotsCode">
        <Card Class="docs-card-demo">
            <Header>
                <h3 class="trazos-heading">@L.T("Design team", "Equipo de diseño")</h3>
            </Header>
            <ChildContent>
                <p>@L.T("Reviews new work every Friday at 4:00 pm.", "Revisa el trabajo nuevo todos los viernes a las 4:00 p. m.")</p>
            </ChildContent>
            <Footer>
                <Button Size="ButtonSize.Small">@L.T("Join", "Unirme")</Button>
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost">@L.T("Details", "Detalles")</Button>
            </Footer>
        </Card>
    </DemoBlock>

    <DemoBlock Title="@L.T("Clickable", "Clicable")" Description="@L.T("Interactive lifts on hover. Pair it with OnClick.", "Interactive se eleva al pasar el cursor. Combínalo con OnClick.")" Code="@ClickCode">
        <Card Variant="CardVariant.Interactive" OnClick="() => _clicks++">
            <h3 class="trazos-heading">@L.T("Click me", "Haz clic aquí")</h3>
            <p class="docs-muted"><Tr><En>Clicked @_clicks time(s).</En><Es>Clics: @(_clicks).</Es></Tr></p>
        </Card>
    </DemoBlock>

    <DemoBlock Title="@L.T("Media and fill", "Media y Fill")" Description="@L.T("Media renders above the body without a divider. Fill lets a row stick to the bottom of an equal-height grid.", "Media se renderiza sobre el cuerpo, sin línea divisoria. Fill permite fijar una fila al fondo de una cuadrícula de igual altura.")" Code="@MediaCode">
        <div class="docs-grid-2">
            <Card Fill="true" Variant="CardVariant.Sky">
                <Media><img src="favicon.svg" alt="" width="64" height="64" style="width: 4rem; margin: 1rem auto;" /></Media>
                <ChildContent>
                    <h3 class="trazos-heading">@L.T("Short", "Corta")</h3>
                    <div style="margin-top: auto;"><Button Size="ButtonSize.Small">@L.T("Open", "Abrir")</Button></div>
                </ChildContent>
            </Card>
            <Card Fill="true" Variant="CardVariant.Gold">
                <Media><img src="favicon.svg" alt="" width="64" height="64" style="width: 4rem; margin: 1rem auto;" /></Media>
                <ChildContent>
                    <h3 class="trazos-heading">@L.T("Longer", "Más larga")</h3>
                    <p>@L.T("This card has more text, and both buttons still line up.", "Esta tarjeta tiene más texto, y los dos botones siguen alineados.")</p>
                    <div style="margin-top: auto;"><Button Size="ButtonSize.Small">@L.T("Open", "Abrir")</Button></div>
                </ChildContent>
            </Card>
        </div>
    </DemoBlock>

    <ApiTable Params="Params" />
</DocPage>

@code {
    private int _clicks;

    private const string VariantsCode = """
        <Card Variant="CardVariant.Default">…</Card>
        <Card Variant="CardVariant.White">…</Card>
        <Card Variant="CardVariant.Lavender">…</Card>
        <Card Variant="CardVariant.Interactive">…</Card>
        <Card Variant="CardVariant.Olive">…</Card>
        <Card Variant="CardVariant.Gold">…</Card>
        <Card Variant="CardVariant.Wine">…</Card>
        <Card Variant="CardVariant.Sky">…</Card>
        """;

    private const string MediaCode = """
        <Card Fill="true">
            <Media><img src="cover.jpg" alt="Project cover" /></Media>
            <ChildContent>
                <h3 class="trazos-heading">Project</h3>
                <div style="margin-top: auto;"><Button>Open</Button></div>
            </ChildContent>
        </Card>
        """;

    private const string SlotsCode = """
        <Card>
            <Header>
                <h3 class="trazos-heading">Design team</h3>
            </Header>
            <ChildContent>
                <p>Reviews new work every Friday at 4:00 pm.</p>
            </ChildContent>
            <Footer>
                <Button Size="ButtonSize.Small">Join</Button>
                <Button Size="ButtonSize.Small" Variant="ButtonVariant.Ghost">Details</Button>
            </Footer>
        </Card>
        """;

    private const string ClickCode = """
        <Card Variant="CardVariant.Interactive" OnClick="() => _clicks++">
            <h3 class="trazos-heading">Click me</h3>
            <p>Clicked @_clicks time(s).</p>
        </Card>
        """;

    private IReadOnlyList<ApiParam> Params =>
    [
        new("Variant", "CardVariant", "Default", L.T("Default, White, Lavender, Interactive, Olive, Gold, Wine or Sky.", "Default, White, Lavender, Interactive, Olive, Gold, Wine o Sky.")),
        new("Media", "RenderFragment?", null, L.T("Rendered above the header and body, such as a cover image.", "Se renderiza sobre el encabezado y el cuerpo, como una imagen de portada.")),
        new("Header", "RenderFragment?", null, L.T("Content above the body, separated by a rule.", "Contenido sobre el cuerpo, separado por una línea.")),
        new("ChildContent", "RenderFragment?", null, L.T("Card body.", "Cuerpo de la tarjeta.")),
        new("Footer", "RenderFragment?", null, L.T("Content below the body, usually actions.", "Contenido bajo el cuerpo, normalmente acciones.")),
        new("Fill", "bool", "false", L.T("Makes the body fill the card height, so margin-top: auto pins a row to the bottom.", "Hace que el cuerpo ocupe la altura de la tarjeta, para que margin-top: auto fije una fila al fondo.")),
        new("OnClick", "EventCallback<MouseEventArgs>", null, L.T("Raised when the card is clicked.", "Se dispara al hacer clic en la tarjeta.")),
        new("Class", "string?", null, L.T("Extra CSS classes.", "Clases CSS adicionales.")),
        new("AdditionalAttributes", "Dictionary<string, object>?", null, L.T("Extra HTML attributes.", "Atributos HTML adicionales.")),
    ];
}
