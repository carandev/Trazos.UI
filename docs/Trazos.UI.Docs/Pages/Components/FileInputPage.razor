@page "/components/file-input"

<DocPage Title="FileInput" Category="@L.T("Forms", "Formularios")"
         Lead="@F.Pick(L.T("A drop zone over the native file picker. It checks accepted types and size, lists the chosen files with a remove button and binds them as IReadOnlyList<IBrowserFile>.", "Una zona para soltar archivos sobre el selector nativo. Revisa tipos aceptados y tamaño, lista los archivos elegidos con un botón para quitarlos y los enlaza como IReadOnlyList<IBrowserFile>."), L.T("A drop zone over the native file picker. It checks accepted types and size, lists the chosen files with a remove button and reports them as File[].", "Una zona para soltar archivos sobre el selector nativo. Revisa tipos aceptados y tamaño, lista los archivos elegidos con un botón para quitarlos y los informa como File[]."))">

    <DemoBlock Title="@L.T("Several files", "Varios archivos")" Code="@Code" React="file-input/basic">
        <FileInput Label="@L.T("Supporting documents", "Soportes")" Multiple="true" Accept=".pdf,image/*" MaxFileSize="5 * 1024 * 1024"
                   ButtonText="@L.T("Choose files", "Elige archivos")" DropText="@L.T("or drag them here", "o arrástralos aquí")"
                   Hint="@L.T("PDF or images, up to 5 MB each", "PDF o imágenes, hasta 5 MB cada uno")"
                   RemoveLabelFormat="@L.T("Remove {0}", "Quitar {0}")"
                   TooLargeMessage="@L.T("{0} is larger than {1}.", "{0} pesa más de {1}.")"
                   NotAcceptedMessage="@L.T("{0} is not an accepted file type.", "{0} no es un tipo de archivo permitido.")"
                   @bind-Value="_files" />
    </DemoBlock>

    <DemoBlock Title="@L.T("One required file", "Un archivo obligatorio")"
               Description="@L.T("Without multiple, a new file replaces the previous one. Show the error after the user tries to submit.", "Sin multiple, un archivo nuevo reemplaza al anterior. Muestra el error después de que el usuario intente enviar.")"
               Code="@SingleCode" React="file-input/single">
        <div class="docs-stack">
            <FileInput Label="@L.T("Signed contract", "Contrato firmado")" Required="true" Accept=".pdf" MaxFileSize="2 * 1024 * 1024"
                       Hint="@L.T("One PDF, up to 2 MB", "Un PDF, hasta 2 MB")"
                       Error="@(_submitted && _contract is not { Count: > 0 } ? L.T("Attach the signed contract.", "Adjunta el contrato firmado.") : null)"
                       @bind-Value="_contract" />
            <div>
                <Button OnClick="Send">@L.T("Send", "Enviar")</Button>
            </div>
            @if (_sent is not null)
            {
                <p class="docs-demo-output">@L.T("Sent:", "Enviado:") <strong>@_sent</strong></p>
            }
        </div>
    </DemoBlock>

    <h2 class="docs-h2">@L.T("How to use", "Cómo usarlo")</h2>

    <h3 class="docs-h3">@L.T("When to use it", "Cuándo usarlo")</h3>
    <p>
        @L.T("Use FileInput to attach documents to a form: contracts, receipts, certificates, photos of an ID. It checks type, size and count before your code sees the files and tells the user why a file was rejected. It does not upload anything: your code reads or sends the files when the form is saved.",
             "Usa FileInput para adjuntar documentos a un formulario: contratos, recibos, certificados, fotos de un documento de identidad. Revisa el tipo, el tamaño y la cantidad antes de que tu código vea los archivos, y le explica al usuario por qué se rechazó un archivo. No sube nada: tu código lee o envía los archivos cuando se guarda el formulario.")
    </p>

    <h3 class="docs-h3">@L.T("Step by step", "Paso a paso")</h3>
    <ol>
        <li>@F.Pick(L.T("Bind an IReadOnlyList<IBrowserFile>? with @bind-Value. It is null while there are no files.", "Enlaza un IReadOnlyList<IBrowserFile>? con @bind-Value. Es null mientras no hay archivos."), L.T("Keep a File[] in state and pass value and onValueChange (or defaultValue). It is [] while there are no files.", "Guarda un File[] en el estado y pasa value y onValueChange (o defaultValue). Es [] mientras no hay archivos."))</li>
        <li>@F.Pick(L.T("Limit what is accepted: Accept with extensions or MIME types (.pdf,image/*), MaxFileSize in bytes, and Multiple with MaxFiles for several files.", "Limita lo que se acepta: Accept con extensiones o tipos MIME (.pdf,image/*), MaxFileSize en bytes, y Multiple con MaxFiles para varios archivos."), L.T("Limit what is accepted: accept with extensions or MIME types (.pdf,image/*), maxFileSize in bytes, and multiple with maxFiles for several files.", "Limita lo que se acepta: accept con extensiones o tipos MIME (.pdf,image/*), maxFileSize en bytes, y multiple con maxFiles para varios archivos."))</li>
        <li>@F.Pick(L.T("Say the limits in Hint (\"PDF up to 5 MB\") so people know them before choosing.", "Di los límites en Hint (\"PDF hasta 5 MB\") para que las personas los conozcan antes de elegir."), L.T("Say the limits in hint (\"PDF up to 5 MB\") so people know them before choosing.", "Di los límites en hint (\"PDF hasta 5 MB\") para que las personas los conozcan antes de elegir."))</li>
        <li>@L.T("Translate the texts: the button and drop texts, the remove label and the three rejection messages. In the messages {0} is the file name and {1} the size or count limit.", "Traduce los textos: el del botón y el de soltar, la etiqueta de quitar y los tres mensajes de rechazo. En los mensajes, {0} es el nombre del archivo y {1} el límite de tamaño o de cantidad.")</li>
        <li>@F.Pick(L.T("When saving, read each file with OpenReadStream(maxAllowedSize). Its default limit is 500 KB, so pass the same limit as MaxFileSize.", "Al guardar, lee cada archivo con OpenReadStream(maxAllowedSize). Su límite por defecto es 500 KB, así que pasa el mismo límite que MaxFileSize."), L.T("When saving, send the files with FormData and fetch, or read them with file.arrayBuffer() or file.text().", "Al guardar, envía los archivos con FormData y fetch, o léelos con file.arrayBuffer() o file.text()."))</li>
    </ol>

    <h3 class="docs-h3">@L.T("Binding and validation", "Enlace y validación")</h3>
    <p>
        @L.T("Rejected files never reach the value: they are listed as messages under the zone, and when every new file is rejected the previous selection stays. Required is your rule: check for an empty list and pass the error. Always check type and size again on the server, because the browser can be bypassed.",
             "Los archivos rechazados nunca llegan al valor: se listan como mensajes debajo de la zona, y cuando todos los archivos nuevos se rechazan se conserva la selección anterior. Que sea obligatorio es regla tuya: revisa si la lista está vacía y pasa el error. Revisa siempre el tipo y el tamaño de nuevo en el servidor, porque el navegador se puede evadir.")
    </p>
    <CodeBlock Language="@F.Pick("razor", "tsx")" Code="@F.Pick(SaveCode, ReactSaveCode)" />

    <h3 class="docs-h3">@L.T("Keyboard and screen readers", "Teclado y lectores de pantalla")</h3>
    <ul>
        <li>@L.T("The zone is a real file input stretched over the drop area, so Tab reaches it, Enter or Space opens the file dialog, and dropping files works with a mouse.", "La zona es un input de archivo real extendido sobre el área para soltar, así que Tab llega a él, Enter o Espacio abren el diálogo de archivos y soltar archivos funciona con el ratón.")</li>
        <li>@L.T("Each chosen file has a remove button named with RemoveLabelFormat (\"Remove contract.pdf\").", "Cada archivo elegido tiene un botón de quitar con el nombre de RemoveLabelFormat (\"Quitar contrato.pdf\").")</li>
        <li>@L.T("Rejection messages and the error are announced as alerts; the helper text and the error are linked to the input with aria-describedby.", "Los mensajes de rechazo y el error se anuncian como alertas; el texto de ayuda y el error se vinculan al input con aria-describedby.")</li>
    </ul>

    <h3 class="docs-h3">@L.T("Common pitfalls", "Errores comunes")</h3>
    <ul>
        <li>@L.T("Trusting the file name extension alone: check the content on the server before storing or opening it.", "Confiar solo en la extensión del nombre: revisa el contenido en el servidor antes de guardarlo o abrirlo.")</li>
        <li>@F.Pick(L.T("Reading a file after the component is gone: IBrowserFile streams only work while the page is open, so read them when saving.", "Leer un archivo cuando el componente ya no existe: los flujos de IBrowserFile solo funcionan mientras la página está abierta, así que léelos al guardar."), L.T("Putting File objects in JSON: send them with FormData instead.", "Poner objetos File en JSON: envíalos con FormData."))</li>
        <li>@L.T("Setting a size limit in the component but not on the server or the proxy: large uploads then fail with an unclear error.", "Poner un límite de tamaño en el componente pero no en el servidor o el proxy: las subidas grandes fallan con un error poco claro.")</li>
    </ul>

    <ApiTable Params="Params" ReactParams="ReactParams" />
</DocPage>

@code {
    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile>? _files;
    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile>? _contract;
    private bool _submitted;
    private string? _sent;

    private void Send()
    {
        _submitted = true;
        _sent = _contract is { Count: > 0 } files ? files[0].Name : null;
    }

    private const string SingleCode = """
        <FileInput Label="Signed contract" Required="true" Accept=".pdf" MaxFileSize="2 * 1024 * 1024"
                   Hint="One PDF, up to 2 MB"
                   Error="@(_submitted && _contract is not { Count: > 0 } ? "Attach the signed contract." : null)"
                   @bind-Value="_contract" />
        <Button OnClick="Send">Send</Button>

        @code {
            private IReadOnlyList<IBrowserFile>? _contract;
            private bool _submitted;

            private void Send() => _submitted = true;
        }
        """;

    private const string SaveCode = """
        private async Task SaveAsync()
        {
            foreach (var file in _files ?? [])
            {
                await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                await Storage.SaveAsync(file.Name, file.ContentType, stream);
            }
        }
        """;

    private const string ReactSaveCode = """
        const [files, setFiles] = useState<File[]>([]);

        async function save() {
          const body = new FormData();
          for (const file of files) body.append('documents', file, file.name);
          await fetch('/api/documents', { method: 'POST', body });
        }
        """;

    private const string Code = """
        <FileInput Label="Supporting documents" Multiple="true" Accept=".pdf,image/*"
                   MaxFileSize="5 * 1024 * 1024" Hint="PDF or images, up to 5 MB each"
                   @bind-Value="_files" />

        @code {
            private IReadOnlyList<IBrowserFile>? _files;

            // Later: await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        }
        """;

    private IReadOnlyList<ApiParam> Params =>
    [
        new("Value", "IReadOnlyList<IBrowserFile>?", null, L.T("Chosen files. Supports @bind-Value and EditForm validation.", "Archivos elegidos. Admite @bind-Value y validación con EditForm.")),
        new("Accept", "string?", null, L.T("Accepted types, as in the accept attribute: .pdf,image/*.", "Tipos aceptados, como en el atributo accept: .pdf,image/*.")),
        new("MaxFileSize", "long?", null, L.T("Largest file in bytes.", "Archivo más grande en bytes.")),
        new("Multiple / MaxFiles", "bool / int", "false / 10", L.T("Keeps several files, up to MaxFiles. Without Multiple a new file replaces the old one.", "Guarda varios archivos, hasta MaxFiles. Sin Multiple, un archivo nuevo reemplaza al anterior.")),
        new("ButtonText, DropText, Hint", "string", null, L.T("Text in the drop zone.", "Texto de la zona.")),
        new("RemoveLabelFormat, TooLargeMessage, NotAcceptedMessage, TooManyMessage", "string", L.T("English", "inglés"), L.T("Accessible names and rejection messages. {0} is the file name.", "Nombres accesibles y mensajes de rechazo. {0} es el nombre del archivo.")),
        new("Label, HelperText, Error, Required, Disabled", "", null, L.T("Same as the other fields.", "Igual que en los demás campos.")),
    ];

    private IReadOnlyList<ApiParam> ReactParams =>
    [
        new("value", "readonly File[]", null, L.T("Controlled list of chosen files. Pair it with onValueChange.", "Lista controlada de archivos elegidos. Úsala junto con onValueChange.")),
        new("defaultValue", "readonly File[]", "[]", L.T("Initial files for uncontrolled use.", "Archivos iniciales para uso no controlado.")),
        new("onValueChange", "(files: File[]) => void", null, L.T("Called when files are added or removed. Not called when every new file is rejected.", "Se llama cuando se agregan o quitan archivos. No se llama cuando todos los archivos nuevos se rechazan.")),
        new("accept", "string", null, L.T("Accepted types, as in the accept attribute: .pdf,image/*. Also checked for dropped files.", "Tipos aceptados, como en el atributo accept: .pdf,image/*. También se revisa en los archivos soltados.")),
        new("maxFileSize", "number", null, L.T("Largest file in bytes.", "Archivo más grande en bytes.")),
        new("multiple / maxFiles", "boolean / number", "false / 10", L.T("Keeps several files, up to maxFiles. Without multiple a new file replaces the old one.", "Guarda varios archivos, hasta maxFiles. Sin multiple, un archivo nuevo reemplaza al anterior.")),
        new("buttonText, dropText, hint", "string", L.T("'Choose a file', 'or drag it here'", "'Choose a file', 'or drag it here'"), L.T("Text in the drop zone.", "Texto de la zona.")),
        new("removeLabelFormat", "string", "'Remove {0}'", L.T("Accessible name of each remove button. {0} is the file name.", "Nombre accesible de cada botón de quitar. {0} es el nombre del archivo.")),
        new("tooLargeMessage", "string", "'{0} is larger than {1}.'", L.T("{0} is the file name and {1} the size limit.", "{0} es el nombre del archivo y {1} el límite de tamaño.")),
        new("notAcceptedMessage", "string", "'{0} is not an accepted file type.'", L.T("{0} is the file name.", "{0} es el nombre del archivo.")),
        new("tooManyMessage", "string", "'{0} was not added: the limit is {1} files.'", L.T("{0} is the file name and {1} the file limit.", "{0} es el nombre del archivo y {1} el límite de archivos.")),
        new("label, helperText, error, required, disabled", "", null, L.T("Same as the other fields.", "Igual que en los demás campos.")),
        new("...rest", "ComponentPropsWithRef<'input'>", null, L.T("Any other attribute for the native file input, including ref, name and onChange.", "Cualquier otro atributo para el input de archivo nativo, incluidos ref, name y onChange.")),
    ];
}
